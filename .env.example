# Required upstream Snipe-IT URL. HTTPS is mandatory except for loopback development.
SNIPEIT_URL=https://snipeit.example.com

# Mode A: shared Snipe-IT personal access token / service account.
SNIPEIT_TOKEN=replace-with-snipeit-personal-access-token
# Separate inbound MCP bearer used by Copilot Studio; minimum 32 chars and never equal to SNIPEIT_TOKEN.
SNIPEIT_MCP_TOKEN=replace-with-a-separate-random-32-plus-character-secret

# Mode B: per-user Snipe-IT Laravel Passport OAuth. Uncomment all values and remove SNIPEIT_TOKEN.
#SNIPEIT_OAUTH_CLIENT_ID=replace-with-passport-client-id
#SNIPEIT_OAUTH_CLIENT_SECRET=replace-with-passport-client-secret
#SNIPEIT_MCP_BASE_URL=https://snipeit-mcp.example.com
#SNIPEIT_MCP_REDIRECT_PATH=/auth/callback
#SNIPEIT_OAUTH_ALLOWED_REDIRECT_URIS=https://global.consent.azure-apim.net/redirect,https://*.consent.azure-apim.net/redirect
#SNIPEIT_OAUTH_JWT_SIGNING_KEY=replace-with-a-long-random-signing-key

# Production transport. FastMCP serves Streamable HTTP at /mcp.
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Optional exact, case-sensitive allowlist. Unset to expose all 29 tools.
#SNIPEIT_ALLOWED_TOOLS=assets_search,users_search,user_inventory,inventory_search,catalog_search

# TLS and bounded I/O.
#SNIPEIT_CA_BUNDLE=/etc/ssl/certs/company-root-ca.pem
SNIPEIT_VERIFY_TLS=true
# Disabling verification is intentionally two-step and is not recommended.
#SNIPEIT_ALLOW_INSECURE_TLS=false
SNIPEIT_TIMEOUT=20
SNIPEIT_UPLOAD_TIMEOUT=120
SNIPEIT_DOWNLOAD_TIMEOUT=120
SNIPEIT_LONG_OPERATION_TIMEOUT=300
SNIPEIT_MAX_UPLOAD_BYTES=52428800
SNIPEIT_MAX_DOWNLOAD_BYTES=104857600
SNIPEIT_MAX_JSON_RESPONSE_BYTES=10485760

LOG_LEVEL=INFO
FASTMCP_HOME=/var/lib/snipeit-copilot-mcp

# Integration tests are off unless explicitly enabled.
#SNIPEIT_INTEGRATION_TESTS=true
#SNIPEIT_INTEGRATION_URL=https://snipeit-test.example.com
#SNIPEIT_INTEGRATION_TOKEN=replace-with-test-instance-token
#SNIPEIT_INTEGRATION_ALLOW_DESTRUCTIVE=false

